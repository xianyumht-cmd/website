{
  "name": "website-main",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint:html": "html-validate \"*.html\" \"src/pages/**/*.html\" \"public/**/*.html\"",
    "lint:css": "stylelint \"src/assets/css/**/*.css\"",
    "lint:js": "eslint \"src/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"vite.config.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "dev": "vite",
    "build": "vite build && node scripts/organize-dist.mjs && node scripts/postbuild-optimize.mjs",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "update:lol-version": "node scripts/update-lol-version.js",
    "preview": "vite preview",
    "test:unit": "jest tests/unit --runInBand",
    "test:smoke": "playwright test tests/down.spec.ts tests/e2e",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:e2e": "npm run test:smoke",
    "test:perf": "node scripts/perf-threshold.mjs",
    "test:perf:prod": "node scripts/perf-production.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:e2e && npm run test:perf"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/helper-validator-identifier": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@html-validate/stylish": "^5.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "html-validate": "^10.7.0",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lighthouse": "^13.0.1",
    "playwright": "^1.58.0",
    "rollup": "^4.57.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.46.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0"
  }
}
