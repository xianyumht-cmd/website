# Cloudflare Pages response headers
# Keep caching rules explicit and add a conservative security baseline that does
# not restrict the site's current script/style/font/CDN loading model.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'

# HTML Files: NEVER CACHE
# Ensures users always get the latest document that points to the current hashed assets.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root path (home page): always revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate

# Vite-generated hashed assets: cache for one year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed data/text files: always revalidate.
/*.json
  Cache-Control: public, max-age=0, must-revalidate
/*.xml
  Cache-Control: public, max-age=0, must-revalidate
/*.txt
  Cache-Control: public, max-age=0, must-revalidate
